{
  "name": "gumdrop",
  "version": "5.0.0",
  "description": "Zero-configuration script to display Markdown documents as static HTML pages",
  "author": "Márton Visnovitz <visnovitz.marton@gmail.com>",
  "license": "MIT",
  "repository": "github:vimtaai/gumdrop",
  "type": "module",
  "scripts": {
    "lint": "eslint 'src/**/*.js'",
    "format": "prettier --check 'src/**/*.js'",
    "test": "node --import='./test/setup.js' --test 'src/**/*.test.js'",
    "test:only": "node --import='./test/setup.js' --test --test-only 'src/**/*.test.js'",
    "test:coverage": "node --import='./test/setup.js' --test --experimental-test-coverage 'src/**/*.test.js'",
    "test:watch": "node --watch --import='./test/setup.js' --test 'src/**/*.test.js'",
    "build": "node esbuild.config.js",
    "build:watch": "npm run build -- --watch"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "happy-dom": "^16.0.1",
    "prettier": "^3.4.2"
  }
}
