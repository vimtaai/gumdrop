{
  "name": "gumdrop",
  "version": "5.0.0",
  "description": "Frontmatter-driven templating, data resolution and Markdown rendering",
  "author": "Márton Visnovitz <vimtaai@pm.me>",
  "license": "MIT",
  "repository": "github:vimtaai/gumdrop",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib/**/*.js",
    "!lib/**/*.test.js"
  ],
  "scripts": {
    "test": "node --test \"lib/**/*.test.js\"",
    "test:watch": "node --watch --test \"lib/**/*.test.js\"",
    "check": "biome check",
    "check:ci": "biome ci",
    "check:fix": "biome check --write"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "extramark": "^3.0.1",
    "jsdom": "^30.0.1",
    "liquidjs": "^10.29.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13"
  }
}
